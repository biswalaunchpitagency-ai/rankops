# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://localhost:5432/helpdesk?schema=public"

BETTER_AUTH_SECRET="" # Required: generate with `openssl rand -base64 32`
BETTER_AUTH_URL="http://localhost:3000"

TRUSTED_ORIGINS="http://localhost:5173"

# Google SSO Authentication Credentials (Google Cloud Console OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

WEBHOOK_SECRET="" # Required for inbound email webhook

OPENAI_API_KEY="" # Required for AI features (OpenAI or compatible provider)
OPENAI_BASE_URL="" # Optional: Custom base URL for OpenAI-compatible APIs (e.g. https://integrate.api.nvidia.com/v1)
OPENAI_MODEL="" # Optional: Custom model name (e.g. meta/llama-3.1-8b-instruct). Defaults to gpt-5-nano if left empty.

# Outbound Email Setup (Nodemailer SMTP/OAuth or SendGrid)
# Option A: Nodemailer SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false" # "true" for 465, "false" for 587/25
SMTP_USER="" # Your email address (e.g. sender@gmail.com)
SMTP_PASS="" # Your email password or app password

# Option B: Nodemailer OAuth2
SMTP_AUTH_TYPE="" # Set to "OAuth2" to enable
SMTP_CLIENT_ID=""
SMTP_CLIENT_SECRET=""
SMTP_REFRESH_TOKEN=""

# Option C: SendGrid (used if SMTP_USER is empty)
SENDGRID_API_KEY="" 
SENDGRID_FROM_EMAIL="" # Verified sender address (e.g. support@yourdomain.com)

SENTRY_DSN="" # Optional: Sentry error tracking DSN
SENTRY_ENVIRONMENT="" # e.g. development, staging, production

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="" # Use a strong password

# Option D: Custom Filters & Routing
GMAIL_QUERY_FILTER="is:unread label:Support"
SMTP_REPLY_TO="thelaunchpit+support@gmail.com"
SENDGRID_REPLY_TO="thelaunchpit+support@gmail.com"
CLIENT_URL="http://localhost:5173"
GMAIL_POLLING_INTERVAL="900000"